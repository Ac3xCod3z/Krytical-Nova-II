#game-ui { flex-grow: 1; color: rgb(231, 235, 240); font-size: 14px; }
.panel { background-color: rgba(16, 22, 31, 0.96); border-color: rgb(65, 77, 90); border-width: 1px; border-radius: 7px; padding: 16px; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.heading { font-size: 19px; -unity-font-style: bold; color: rgb(244, 238, 223); }
.eyebrow { font-size: 11px; -unity-font-style: bold; color: rgb(184, 154, 94); letter-spacing: 1px; }
.accent { color: rgb(114, 222, 196); font-size: 13px; }
.muted { color: rgb(155, 166, 181); font-size: 12px; margin-top: 5px; }
.help { white-space: normal; color: rgb(163, 176, 191); font-size: 12px; margin-top: 8px; }
.section { margin-top: 12px; }
#summary { position: absolute; top: 18px; left: 20px; width: 330px; }
#summary .row { margin-top: 4px; margin-bottom: 6px; }
#xp-bar { height: 20px; margin: 4px 0; }
#xp-bar .unity-progress-bar__background { background-color: rgb(33, 43, 57); border-radius: 3px; }
#xp-bar .unity-progress-bar__progress { background-color: rgb(39, 131, 120); }
#xp-bar .unity-progress-bar__title { font-size: 11px; color: white; }
#menu { position: absolute; right: 20px; top: 20px; }
Button { min-height: 30px; background-color: rgb(40, 53, 67); color: rgb(226, 233, 240); border-color: rgb(74, 92, 105); border-width: 1px; border-radius: 4px; margin: 4px 0; padding: 5px 10px; -unity-font-style: bold; }
Button:hover { background-color: rgb(59, 78, 94); border-color: rgb(162, 188, 192); }
Button:active { background-color: rgb(34, 105, 94); }
Button:disabled { color: rgb(120, 131, 144); background-color: rgb(31, 38, 48); border-color: rgb(50, 61, 72); }
#menu Button { margin-left: 8px; }
.window { position: absolute; width: 328px; top: 165px; }
#character-window { left: 20px; width: 300px; top: 250px; }
#skills-window { right: 20px; width: 310px; top: 80px; }
#character-body { max-height: 255px; }
#skills-body { max-height: 420px; }
.window-body .unity-scroll-view__content-container { padding-right: 4px; }
.close { width: 28px; min-height: 26px; padding: 0; margin: 0; }
.stat-row { flex-direction: row; align-items: center; margin-top: 10px; background-color: rgb(24, 32, 43); padding: 4px 9px; border-radius: 4px; }
.stat-row > Label { flex-grow: 1; }
.stat-row .stat-value { flex-grow: 0; width: 42px; -unity-text-align: middle-center; color: rgb(229, 204, 147); }
.stat-row Button { width: 32px; padding: 0; }
.skill-card { background-color: rgb(24, 32, 43); padding: 12px; border-radius: 4px; margin-top: 12px; }
.skill-token { padding: 8px; background-color: rgb(30, 64, 63); border-radius: 4px; border-color: rgb(62, 132, 119); border-width: 1px; }
.skill-token:hover { background-color: rgb(40, 87, 82); }
.skill-icon { font-size: 20px; -unity-font-style: bold; color: rgb(125, 230, 205); }
#run-rank { font-size: 11px; margin-top: 3px; }
.future-skill { opacity: 0.65; }
.future-skill .skill-icon { color: rgb(164, 179, 201); }
#development-tools { padding-top: 6px; border-top-width: 1px; border-top-color: rgb(58, 70, 84); }
#bottom-region { position: absolute; bottom: 12px; left: 0; right: 0; align-items: center; }
.feedback { background-color: rgba(14, 20, 28, 0.88); border-radius: 4px; padding: 7px 14px; margin-bottom: 8px; color: rgb(229, 213, 173); font-size: 12px; }
#hotbar { flex-direction: row; background-color: rgba(11, 16, 23, 0.96); padding: 7px; border-radius: 7px; border-color: rgb(77, 85, 92); border-width: 1px; }
.hotbar-slot { width: 54px; height: 70px; margin: 0 3px; padding: 4px; background-color: rgb(28, 37, 49); border-width: 1px; border-color: rgb(66, 80, 95); border-radius: 3px; }
.hotbar-slot:hover { border-color: rgb(170, 193, 208); background-color: rgb(42, 56, 69); }
.hotbar-slot.selected { border-color: rgb(112, 229, 188); background-color: rgb(24, 83, 68); }
.hotbar-slot.drop-target { border-color: rgb(238, 201, 125); background-color: rgb(87, 76, 42); }
.hotbar-slot Label { margin: 0; padding: 0; min-height: 0; }
.slot-key { height: 14px; flex-shrink: 0; font-size: 11px; color: rgb(222, 202, 161); }
.slot-name { height: 24px; flex-shrink: 0; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 14px; }
.slot-rank { height: 14px; flex-shrink: 0; -unity-text-align: middle-center; font-size: 9px; color: rgb(147, 165, 183); }
.controls { font-size: 11px; color: rgb(215, 225, 235); background-color: rgba(14, 20, 28, 0.8); margin-top: 6px; padding: 3px 8px; border-radius: 3px; }
#drag-ghost { display: none; position: absolute; width: 64px; height: 48px; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 18px; background-color: rgba(32, 122, 99, 0.94); border-color: rgb(184, 242, 213); border-width: 2px; border-radius: 4px; }


.window-body .unity-scroller--vertical { width: 8px; min-width: 8px; margin-left: 5px; }
.window-body .unity-scroller__low-button, .window-body .unity-scroller__high-button { display: none; }
.window-body .unity-base-slider__tracker { background-color: rgb(29, 40, 53); border-width: 0; }

.resource-bar { height: 22px; margin: 4px 0; }
.resource-bar .unity-progress-bar__background { background-color: rgb(33, 43, 57); border-radius: 3px; }
.resource-bar .unity-progress-bar__title { color: white; font-size: 12px; -unity-font-style: bold; }
#hp-bar .unity-progress-bar__progress { background-color: rgb(161, 56, 72); }
#chi-bar .unity-progress-bar__progress { background-color: rgb(45, 118, 182); }
#run-values, #jump-values, #resource-values { white-space: normal; font-size: 12px; }
.jump-token { background-color: rgb(38, 51, 86); border-color: rgb(93, 124, 196); }
.jump-token .skill-icon { color: rgb(140, 183, 250); }
#jump-rank { font-size: 11px; margin-top: 3px; }
.hotbar-slot.insufficient-chi { border-color: rgb(177, 70, 77); }

.window-body .unity-base-slider__dragger { background-color: rgb(74, 103, 112); border-width: 0; border-radius: 3px; min-width: 6px; }
