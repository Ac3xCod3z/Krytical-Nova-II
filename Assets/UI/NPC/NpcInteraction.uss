/* NPC nameplates, dialogue and zone toast. Shared skin: ../Shared/KryticalTheme.uss */

#npc-ui { flex-grow: 1; }
#nameplates { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.nameplate {
    position: absolute;
    align-items: center;
    padding: 3px 14px 4px 14px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01.png#SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01");
    -unity-background-image-tint-color: rgba(6, 12, 18, 0.72);
    -unity-slice-scale: 0.1px;
}
.nameplate-name {
    font-size: 15px;
    color: rgb(255, 214, 92);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    padding: 0;
    margin: 0;
}
.nameplate-title {
    font-size: 11px;
    color: rgb(150, 226, 236);
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

#zone-toast {
    position: absolute;
    top: 22%;
    left: 50%;
    translate: -50% 0;
    max-width: 640px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 19px;
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
    letter-spacing: 1px;
    color: rgb(176, 238, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    padding: 10px 46px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01.png#SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01");
    -unity-background-image-tint-color: rgba(6, 16, 26, 0.9);
    -unity-slice-scale: 0.2px;
}

#npc-dialogue {
    position: absolute;
    bottom: 205px;
    left: 50%;
    width: 470px;
    translate: -50% 0;
    padding: 16px 20px;
}
#npc-dialogue > .kn-frame { -unity-background-image-tint-color: rgba(255, 214, 92, 0.6); }
#npc-dialogue > .kn-pip { -unity-background-image-tint-color: rgb(255, 214, 92); }
.npc-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.npc-header-text { flex-shrink: 1; }
.npc-eyebrow { font-size: 11px; color: rgb(214, 178, 104); letter-spacing: 2px; padding: 0; margin: 0; }
.npc-heading { font-size: 20px; color: rgb(255, 214, 92); -unity-text-outline-width: 0.6px; -unity-text-outline-color: rgb(0, 0, 0); padding: 0; margin: 2px 0 0 0; }
.npc-greeting { white-space: normal; font-size: 15px; -unity-font-style: italic; color: rgb(236, 240, 244); margin-top: 10px; }
.npc-services { white-space: normal; font-size: 12px; color: rgb(156, 172, 188); margin-top: 8px; }
.npc-actions { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
