/*
 * The forge window (GearWorkWindowController). Shared looks (panel, buttons, cards) come from
 * ../Common/KryticalTheme.uss; item icons and rarity colours from Items.uss.
 */

#forge-window { left: 50%; top: 84px; width: 620px; translate: -50% 0; display: none; }
.forge-purse { flex-grow: 1; margin-left: 14px; font-size: 12px; -unity-text-align: middle-left; }

.forge-tabs { flex-direction: row; margin-top: 2px; }
.forge-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 28px;
    margin: 4px 2px 0 2px;
    padding: 4px 4px;
    font-size: 11px;
    -unity-background-image-tint-color: rgb(24, 34, 46);
    color: rgb(156, 172, 188);
}
.forge-tab.active { -unity-background-image-tint-color: rgb(30, 112, 98); color: rgb(255, 255, 255); }

.forge-body { flex-direction: row; margin-top: 10px; }
.forge-column { flex-basis: 0; }
.forge-list-column { flex-grow: 5; margin-right: 12px; }
.forge-detail { flex-grow: 6; }
.forge-items { height: 340px; margin-top: 4px; }

/* One piece of gear in the list. */
.forge-item {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    padding: 4px 6px;
    min-height: 44px;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.1s;
}
.forge-item:hover { -unity-background-image-tint-color: rgba(40, 60, 78, 0.95); }
.forge-item.selected { -unity-background-image-tint-color: rgba(28, 96, 86, 0.95); }
.forge-item.material { -unity-background-image-tint-color: rgba(96, 78, 30, 0.95); }
.forge-item-icon { width: 36px; height: 36px; flex-shrink: 0; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.forge-item-text { flex-grow: 1; flex-shrink: 1; }
.forge-item-title { font-size: 12px; white-space: normal; }
.forge-item-sub { font-size: 10px; color: rgb(146, 162, 178); }
.forge-item-tag { font-size: 11px; margin-left: 6px; -unity-font-style: bold; }
.forge-empty { margin-top: 12px; white-space: normal; font-size: 12px; color: rgb(146, 162, 178); }

.forge-item-name { font-size: 15px; white-space: normal; }
.forge-item-state { font-size: 12px; margin-top: 2px; min-height: 16px; -unity-font-style: bold; }

.forge-options { flex-direction: row; flex-wrap: wrap; }
.forge-option {
    min-height: 26px;
    margin: 3px 4px 0 0;
    padding: 2px 8px;
    font-size: 11px;
    -unity-background-image-tint-color: rgb(28, 40, 54);
}
.forge-option.chosen { -unity-background-image-tint-color: rgb(30, 112, 98); color: rgb(255, 255, 255); }

.forge-odds { margin-top: 10px; white-space: normal; font-size: 12px; color: rgb(208, 220, 230); }
.forge-reason { margin-top: 6px; min-height: 16px; white-space: normal; font-size: 12px; color: rgb(236, 150, 110); }
#forge-act { margin-top: 8px; min-height: 34px; }
.forge-result { margin-top: 8px; min-height: 18px; white-space: normal; font-size: 13px; -unity-font-style: bold; }
.forge-result.success { color: rgb(114, 222, 196); }
.forge-result.fail { color: rgb(236, 206, 140); }
.forge-result.broken { color: rgb(240, 96, 88); }

/* Temper % on an item icon (Pack, Equipment). The colour is the glow band's, set in code. */
.item-temper {
    position: absolute;
    left: 3px;
    bottom: 2px;
    font-size: 9px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(8, 10, 16);
}
