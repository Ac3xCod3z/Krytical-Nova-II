<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Items.uss" />
    <!-- Instanced into ProgressionHUD.uxml as a full-screen, click-through layer; driven by GearUIController. -->

    <!-- Equipment page: slots around a live, rotatable 3D model -->
    <ui:VisualElement name="equipment-window" class="panel window blocks-world hud-movable">
        <ui:VisualElement class="row kn-header">
            <ui:Label text="EQUIPMENT" class="heading" />
            <ui:Label text="[U]" class="muted header-key" />
            <ui:VisualElement class="header-spacer" picking-mode="Ignore" />
            <ui:Button name="close-equipment" class="close"><ui:VisualElement class="kn-close-glyph" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="equipment-body">
            <ui:VisualElement class="equip-column">
                <ui:VisualElement name="equip-Weapon" class="equip-slot"><ui:Label text="WEAPON" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Armor" class="equip-slot"><ui:Label text="ARMOR" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Gloves" class="equip-slot"><ui:Label text="GLOVES" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Boots" class="equip-slot"><ui:Label text="BOOTS" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="preview-frame" class="preview-frame">
                <ui:VisualElement class="preview-backdrop" picking-mode="Ignore" />
                <ui:VisualElement class="preview-floor" picking-mode="Ignore" />
                <ui:VisualElement name="preview-viewport" class="preview-viewport" />
                <ui:VisualElement name="try-on-chip" class="try-on-chip">
                    <ui:Label name="try-on-label" text="Trying on" picking-mode="Ignore" />
                    <ui:Button name="try-on-clear" text="✕" class="try-on-clear" />
                </ui:VisualElement>
                <ui:Button name="preview-reset" text="RESET VIEW" class="preview-reset" />
                <ui:Label text="Drag rotate  ·  Middle-drag pan  ·  Scroll zoom  ·  Double-click reset" class="preview-hint" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="equip-column">
                <ui:VisualElement name="equip-Amulet" class="equip-slot"><ui:Label text="AMULET" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Ring" class="equip-slot"><ui:Label text="RING" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Cape" class="equip-slot"><ui:Label text="CAPE" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-Pet" class="equip-slot"><ui:Label text="PET" class="equip-label" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Right-click a slot to unequip  ·  Left-click for options" class="help" />
    </ui:VisualElement>

    <!-- Inventory grid (cells are generated by GearUIController) -->
    <ui:VisualElement name="inventory-window" class="panel window blocks-world hud-movable">
        <ui:VisualElement class="row kn-header">
            <ui:Label text="PACK" class="heading" />
            <ui:Label text="[I]" class="muted header-key" />
            <ui:VisualElement class="header-spacer" picking-mode="Ignore" />
            <ui:Label name="inventory-count" text="0 / 144" class="accent inventory-count" />
            <ui:Button name="inventory-sort" text="SORT" class="inventory-sort" />
            <ui:Button name="close-inventory" class="close"><ui:VisualElement class="kn-close-glyph" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>
        <!-- Page tabs: hover one while dragging an item to switch pages -->
        <ui:VisualElement class="row inventory-pages">
            <ui:Button name="inventory-page-0" text="I" class="inventory-page" />
            <ui:Button name="inventory-page-1" text="II" class="inventory-page" />
            <ui:Button name="inventory-page-2" text="III" class="inventory-page" />
        </ui:VisualElement>
        <ui:VisualElement name="inventory-grid" class="inventory-grid" />
        <ui:Label text="Right-click to equip or use  ·  Left-click for options  ·  Drag to move" class="help" />
    </ui:VisualElement>

    <!-- Floating layers -->
    <ui:VisualElement name="item-tooltip" class="panel item-tooltip" picking-mode="Ignore">
        <ui:Label name="tooltip-name" text="Item" class="tooltip-name" />
        <ui:Label name="tooltip-type" text="Armor · Common" class="tooltip-type" />
        <ui:Label name="tooltip-requires" text="" class="tooltip-requires" />
        <ui:Label name="tooltip-desc" text="" class="tooltip-desc" />
        <ui:Label name="tooltip-stats" text="No stats yet" class="tooltip-stats" />
        <ui:Label name="tooltip-hint" text="" class="tooltip-hint" />
    </ui:VisualElement>

    <ui:VisualElement name="item-menu" class="panel item-menu blocks-world">
        <ui:Label name="item-menu-title" text="Item" class="item-menu-title" />
        <ui:VisualElement name="item-menu-actions" />
    </ui:VisualElement>

    <ui:VisualElement name="item-confirm" class="panel item-confirm blocks-world">
        <ui:Label name="item-confirm-text" text="Drop this item?" class="item-confirm-text" />
        <ui:Label text="It will be destroyed. This can't be undone." class="help" />
        <ui:VisualElement class="row item-confirm-buttons">
            <ui:Button name="item-confirm-yes" text="DROP" class="kn-button-danger" />
            <ui:Button name="item-confirm-no" text="CANCEL" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="item-drag-ghost" class="item-drag-ghost" picking-mode="Ignore" />
</ui:UXML>
