/* Inventory + Equipment windows. Builds on KryticalTheme.uss / ProgressionHUD.uss (.panel, .window, .kn-*). */

.item-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.header-key { font-size: 11px; margin-left: 6px; -unity-text-align: middle-left; }
.header-spacer { flex-grow: 1; }

/* ------------------------------------------------------------------ windows */

#equipment-window { left: 96px; top: 84px; width: 572px; display: none; }
#inventory-window { left: 680px; top: 84px; width: 372px; display: none; }

/* The paper doll: whose it is between two rules, then the model with the slots down either side of it. */
.doll-band { align-items: center; margin: 2px 0 4px 0; }
.doll-name { font-size: 18px; margin-top: 4px; -unity-text-align: middle-center; color: rgb(244, 238, 223); }
.doll-rank { font-size: 11px; letter-spacing: 1px; -unity-text-align: middle-center; }
.doll-foot-rule { margin-top: 8px; }
.doll-prompts { justify-content: center; margin-top: 6px; }
.equipment-body { flex-direction: row; align-items: stretch; margin-top: 4px; }
.equip-column { width: 96px; justify-content: space-between; align-items: center; padding: 6px 0; }

/* ------------------------------------------------------------------ slots (shared by grid cells and equip slots) */

.item-cell, .equip-slot {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_Glass_04.png#SPR_HUD_SciFiSoldier_Box_Glass_04");
    -unity-background-image-tint-color: rgba(44, 62, 80, 0.85);
    -unity-slice-scale: 0.12px;
    transition-property: scale, -unity-background-image-tint-color, opacity;
    transition-duration: 0.1s;
}

.item-cell {
    width: 50px;
    height: 50px;
    margin: 2px;
}

.equip-slot {
    width: 84px;
    height: 84px;
}

.item-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Frame_04.png#SPR_HUD_SciFiSoldier_Frame_04");
    -unity-background-image-tint-color: rgba(150, 176, 196, 0.35);
    -unity-slice-scale: 0.12px;
}

.item-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Placeholder text icon for items without a sprite (pills) */
.item-glyph {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-text-align: middle-center;
    font-size: 11px;
    white-space: normal;
    color: rgb(240, 236, 220);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf");
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}
.item-glyph.glyph-health { color: rgb(255, 120, 120); }
.item-glyph.glyph-chi { color: rgb(120, 180, 255); }
.item-glyph.glyph-dual { color: rgb(206, 150, 255); }

/* Empty equip slot: a faint silhouette of that slot's gear */
.equip-slot .item-icon.silhouette { -unity-background-image-tint-color: rgba(170, 200, 220, 0.14); }

.item-count {
    position: absolute;
    right: 4px;
    bottom: 1px;
    font-size: 11px;
    color: rgb(240, 236, 220);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf");
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

/* Item level, top-left of a gear icon: tiers of one line share a picture, the number tells them apart. */
.item-level {
    position: absolute;
    left: 4px;
    top: 1px;
    font-size: 10px;
    color: rgb(240, 236, 220);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf");
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

/* What a slot is for, written small along its foot, inside it: an item's picture lies over it. */
.equip-label {
    position: absolute;
    bottom: 5px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 8px;
    letter-spacing: 1px;
    color: rgba(146, 162, 178, 0.75);
}

.item-cell:hover, .equip-slot:hover { -unity-background-image-tint-color: rgba(70, 100, 124, 0.95); scale: 1.05 1.05; }
.item-cell:hover > .item-frame, .equip-slot:hover > .item-frame { -unity-background-image-tint-color: rgba(220, 236, 246, 0.85); }

/* Rarity: tinted frame + a soft glow inside the slot. Common white, Uncommon blue, Rare yellow, Epic purple
   (Legendary, reserved, orange). These are game signals: the faction skin builder leaves .rarity- rules alone. */
.rarity-0 > .item-frame { -unity-background-image-tint-color: rgba(242, 245, 248, 0.92); }
.rarity-1 > .item-frame { -unity-background-image-tint-color: rgb(84, 150, 255); }
.rarity-2 > .item-frame { -unity-background-image-tint-color: rgb(255, 212, 64); }
.rarity-3 > .item-frame { -unity-background-image-tint-color: rgb(186, 104, 255); }
.rarity-4 > .item-frame { -unity-background-image-tint-color: rgb(255, 128, 48); }
.rarity-1 { -unity-background-image-tint-color: rgba(30, 50, 86, 0.9); }
.rarity-2 { -unity-background-image-tint-color: rgba(86, 70, 20, 0.9); }
.rarity-3 { -unity-background-image-tint-color: rgba(58, 34, 86, 0.9); }
.rarity-4 { -unity-background-image-tint-color: rgba(86, 46, 20, 0.9); }

/* Gear the character cannot wear (level, faction or body): still shown, clearly out of reach. */
.item-unusable > .item-icon { opacity: 0.38; }
.item-unusable > .item-level { color: rgb(255, 110, 96); }

/* Drag feedback */
.drag-source { opacity: 0.35; }
.drop-valid > .item-frame { -unity-background-image-tint-color: rgb(140, 255, 220); }
.drop-valid { -unity-background-image-tint-color: rgba(30, 112, 98, 0.95); }
.drop-invalid { opacity: 0.35; }
.drop-hover { scale: 1.1 1.1; }
.drop-hover > .item-frame { -unity-background-image-tint-color: rgb(255, 214, 92); }
.reject-flash > .item-frame { -unity-background-image-tint-color: rgb(230, 70, 80); }

/* ------------------------------------------------------------------ inventory */

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 324px;
    margin: 0 auto;
}

/* The well the grid lies in, with the page tabs standing on its top edge. */
.inventory-well {
    width: 340px;
    margin: 0 auto;
    padding: 8px 0;
    background-color: rgba(4, 10, 16, 0.55);
    border-width: 1px;
    border-color: rgba(114, 222, 196, 0.28);
}
.inventory-pages { width: 340px; margin: 8px auto 0 auto; align-items: flex-end; }
.inventory-page {
    flex-grow: 1;
    min-height: 24px; height: 24px;
    margin: 0 1px; padding: 0;
    font-size: 11px;
    opacity: 0.55;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}
.inventory-page.selected { opacity: 1; height: 28px; color: rgb(114, 222, 196); border-bottom-color: rgb(114, 222, 196); }
.inventory-page.drop-hover { scale: 1.05 1.05; opacity: 1; }
.inventory-footer { width: 340px; margin: 8px auto 0 auto; align-items: center; }
.inventory-foot-label { font-size: 10px; letter-spacing: 1px; margin-right: 6px; }
.inventory-count { font-size: 12px; margin-right: 10px; -unity-text-align: middle-left; }
.inventory-sort { min-height: 24px; height: 24px; margin: 0; padding: 0 12px; font-size: 11px; }
.creds-chip {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 6px;
    background-color: rgba(4, 10, 16, 0.55);
    border-width: 1px;
    border-color: rgba(214, 178, 104, 0.45);
}
.creds-pip {
    width: 12px; height: 12px;
    margin-right: 6px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Pip_Hexagon_01_Active.png#SPR_HUD_SciFiSoldier_Pip_Hexagon_01_Active");
    -unity-background-image-tint-color: rgb(214, 178, 104);
}
.inventory-creds { font-size: 13px; }

/* ------------------------------------------------------------------ 3D preview */

.preview-frame {
    flex-grow: 1;
    height: 430px;
    margin: 0 6px;
    overflow: hidden;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_04.png#SPR_HUD_SciFiSoldier_Box_04");
    -unity-background-image-tint-color: rgba(12, 22, 32, 0.95);
    -unity-slice-scale: 0.18px;
}
/* Plain behind the model: the light is the only thing there (the hexagon pattern that was here fought it). */
.preview-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
/* The light on the model: the pack's stepped glow behind it, round whatever the picture's shape, and its beams
   falling from the top of the picture. Both in the accent, thin enough that the model stays the brightest thing. */
.preview-glow {
    position: absolute;
    left: -20%; right: -20%; top: 5%; height: 72%;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/FX/SPR_FX_SciFiSoldier_Glow_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.3);
    -unity-background-scale-mode: scale-to-fit;
}
.preview-beams {
    position: absolute;
    left: 0; right: 0; top: 0; height: 78%;
    background-image: url("/Assets/Synty/InterfaceDarkFantasyHUD/Sprites/FX/SPR_FX_DarkFantasy_Beams_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.16);
    -unity-background-scale-mode: stretch-to-fill;
}
/* Platform ring under the model's feet (squashed circle reads as a floor disc in perspective). */
.preview-floor {
    position: absolute;
    left: 18%; right: 18%; bottom: 30px; height: 46px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Map_Ring_01_Clean.png#SPR_HUD_SciFiSoldier_Map_Ring_01_Clean");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.45);
    -unity-background-scale-mode: stretch-to-fill;
}
.preview-viewport {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
/* What the mouse does on the model, along the foot of the picture. */
.preview-hint {
    position: absolute;
    left: 0; right: 0; bottom: 4px;
    margin: 0;
    justify-content: center;
}
.preview-hint > .prompt-text { font-size: 10px; margin-right: 10px; }
.preview-hint > .key-mouse { width: 13px; height: 18px; }
.preview-reset {
    position: absolute;
    right: 6px; top: 6px;
    min-height: 22px; height: 22px;
    padding: 0 8px; margin: 0;
    font-size: 10px;
}
.try-on-chip {
    position: absolute;
    left: 6px; top: 6px;
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 10px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_04.png#SPR_HUD_SciFiSoldier_Box_04");
    -unity-background-image-tint-color: rgba(150, 120, 50, 0.95);
    -unity-slice-scale: 0.16px;
    display: none;
}
.try-on-chip Label { font-size: 11px; color: rgb(255, 240, 210); }
.try-on-clear { min-height: 20px; height: 20px; width: 22px; padding: 0; margin: 0 0 0 6px; font-size: 11px; }

/* ------------------------------------------------------------------ tooltip / menu / confirm / ghost */

.item-tooltip {
    position: absolute;
    width: 250px;
    padding: 10px 12px;
    display: none;
}
.tooltip-name { font-size: 15px; -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf"); white-space: normal; }
.tooltip-type { font-size: 11px; color: rgb(214, 178, 104); letter-spacing: 1px; margin-bottom: 6px; }
.tooltip-requires { font-size: 11px; margin-bottom: 4px; color: rgb(170, 184, 196); white-space: normal; }
.tooltip-requires--unmet { color: rgb(255, 110, 96); }
.tooltip-desc { font-size: 12px; white-space: normal; color: rgb(200, 212, 222); }
.tooltip-stats { font-size: 11px; margin-top: 6px; color: rgb(146, 162, 178); white-space: normal; }
.tooltip-hint { font-size: 10px; margin-top: 8px; color: rgb(114, 222, 196); white-space: normal; }

.rarity-text-0 { color: rgb(240, 243, 246); }
.rarity-text-1 { color: rgb(110, 170, 255); }
.rarity-text-2 { color: rgb(255, 218, 96); }
.rarity-text-3 { color: rgb(200, 128, 255); }
.rarity-text-4 { color: rgb(255, 150, 64); }

.item-menu {
    position: absolute;
    min-width: 150px;
    padding: 8px 10px;
    display: none;
}
.item-menu-title { font-size: 12px; margin-bottom: 4px; white-space: normal; max-width: 200px; }
.item-menu Button { margin: 2px 0; min-height: 26px; -unity-text-align: middle-left; }

.item-confirm {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 300px;
    translate: -50% -50%;
    display: none;
}
.item-confirm-text { font-size: 14px; white-space: normal; margin-bottom: 4px; }
.item-confirm-buttons { justify-content: flex-end; margin-top: 8px; }
.item-confirm-buttons Button { margin-left: 8px; }

.item-drag-ghost {
    position: absolute;
    width: 54px;
    height: 54px;
    opacity: 0.9;
    display: none;
    -unity-background-scale-mode: scale-to-fit;
}

/* Pack footer: what the character carries in Creds. */
.inventory-footer {
    justify-content: flex-end;
    align-items: center;
    margin: 6px 12px 0 12px;
}

.inventory-creds-label {
    font-size: 11px;
    letter-spacing: 1px;
    margin-right: 8px;
}

.inventory-creds {
    font-size: 16px;
    -unity-text-align: middle-right;
}

/* A Pack cell whose item is promised elsewhere (offered in a trade, being listed in a Kiosk). */
.item-locked { opacity: 0.38; }

/* Names over items on the ground (LootHudController). */
.loot-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.loot-label {
    position: absolute;
    padding: 1px 7px 2px 7px;
    font-size: 12px;
    background-color: rgba(10, 16, 24, 0.72);
    border-radius: 3px;
    -unity-text-align: middle-center;
}

/* A drop still held for the player who dropped it: dimmed for everyone else. */
.loot-label--held { opacity: 0.6; }
.loot-label--mine { background-color: rgba(18, 52, 48, 0.85); }

/* The local player's own drop, counting down to free for all. Small: two lines and a hairline bar, sitting
   between the hotbar and the hint line (the player can move it in the HUD layout editor). */
.loot-notice {
    position: absolute;
    left: 50%;
    bottom: 58px;
    translate: -50% 0;
    width: 236px;
    padding: 4px 10px 6px 10px;
    align-items: center;
    display: none;
}
.loot-notice-text { font-size: 12px; margin: 0; padding: 0; white-space: normal; -unity-text-align: middle-center; color: rgb(255, 255, 255); }
.loot-notice-help { font-size: 10px; margin: 1px 0 0 0; padding: 0; -unity-text-align: middle-center; }
.loot-notice-bar { align-self: stretch; height: 2px; margin-top: 4px; background-color: rgba(34, 52, 66, 0.9); }
.loot-notice-fill { height: 100%; width: 100%; background-color: rgb(114, 222, 196); }
.loot-notice.ending .loot-notice-fill { background-color: rgb(240, 110, 96); }
.loot-notice.ending .loot-notice-text { color: rgb(255, 196, 150); }
