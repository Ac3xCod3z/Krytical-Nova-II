<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Settings (SettingsPages; shown in the game by HudSettingsController and from character select by MenuSettings).
         Six pages, one shown at a time. The Graphics, Audio, Gameplay and Controls pages are filled in code from the preference
         classes (UI/Runtime/Settings); the Interface page is laid out here; the Guide is built from the GuideLibrary
         asset (UI/Runtime/Guide). Elements with the class in-game-only need
         a character in the world and are hidden in the menus. -->
    <ui:VisualElement name="settings-window" class="panel window blocks-world hud-movable">
        <ui:VisualElement class="row kn-header">
            <ui:Label text="SETTINGS" class="heading" />
            <ui:Label name="key-settings" text="[O]" class="muted header-key" />
            <ui:Button name="close-settings" class="close"><ui:VisualElement class="kn-close-glyph" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="settings-tabs" class="settings-tabs">
            <ui:Button name="settings-tab-graphics" text="GRAPHICS" class="settings-tab" />
            <ui:Button name="settings-tab-audio" text="AUDIO" class="settings-tab" />
            <ui:Button name="settings-tab-interface" text="INTERFACE" class="settings-tab" />
            <ui:Button name="settings-tab-gameplay" text="GAMEPLAY" class="settings-tab" />
            <ui:Button name="settings-tab-controls" text="CONTROLS" class="settings-tab" />
            <ui:Button name="settings-tab-accessibility" text="ACCESS" class="settings-tab" tooltip="Accessibility: flashing effects, colour-blind correction" />
            <ui:Button name="settings-tab-guide" text="GUIDE" class="settings-tab" />
        </ui:VisualElement>
        <ui:ScrollView name="settings-body" class="window-body" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement name="settings-page-graphics" class="settings-page" />
            <ui:VisualElement name="settings-page-audio" class="settings-page" />
            <ui:VisualElement name="settings-page-interface" class="settings-page">
                <ui:Label text="HUD LAYOUT" class="eyebrow section in-game-only" />
                <ui:Label text="Move and resize HUD panels. Drag a panel to move it, drag the gold corner to resize, right-click a panel to put it back. Panels line up with the grid and with each other; hold Alt to place one freely. Your layout is saved on this computer." class="help in-game-only" />
                <ui:Button name="settings-edit-layout" text="CUSTOMIZE HUD LAYOUT" class="kn-button-primary section in-game-only" />
                <ui:Button name="settings-reset-layout" text="RESET HUD LAYOUT" class="kn-button-danger in-game-only" />
                <ui:Toggle name="setting-snap-grid" label="Snap panels to the grid and to each other" value="true" class="kn-toggle kn-card in-game-only" />
                <ui:VisualElement name="settings-layout-options" class="in-game-only" />
                <ui:Label text="WORLD MARKERS" class="eyebrow section" />
                <ui:Toggle name="setting-move-marker" label="Ring at move destination" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-target-ring" label="Ring under selected target" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-nameplates" label="Names over NPCs and players" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-own-namecard" label="My own namecard" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-screen-shake" label="Screen shake &amp; impact effects" value="true" class="kn-toggle kn-card" />
                <ui:Label text="INTERFACE" class="eyebrow section" />
                <ui:Toggle name="setting-controls-hint" label="Show hotbar controls hint" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-pet-chatter" label="Pet chatter (my pet's speech bubbles)" value="true" class="kn-toggle kn-card" />
                <ui:Toggle name="setting-minimap-rotate" label="Rotate minimap with camera" value="true" class="kn-toggle kn-card" />
                <ui:VisualElement name="settings-interface-options" />
            </ui:VisualElement>
            <ui:VisualElement name="settings-page-gameplay" class="settings-page" />
            <ui:VisualElement name="settings-page-controls" class="settings-page" />
            <ui:VisualElement name="settings-page-accessibility" class="settings-page" />
            <ui:VisualElement name="settings-page-guide" class="settings-page" />
        </ui:ScrollView>
        <!-- A setting takes effect as it is changed. APPLY keeps the changes, REVERT puts back what was there when the
             window opened (or was last applied), RESET TO DEFAULTS sets the page shown to its defaults. -->
        <ui:VisualElement name="settings-footer" class="settings-footer">
            <ui:Button name="settings-reset" text="RESET TO DEFAULTS" class="settings-footer-button" tooltip="Sets the page shown back to the game's own values. REVERT undoes it." />
            <ui:VisualElement class="settings-footer-gap" />
            <ui:Button name="settings-revert" text="REVERT" class="settings-footer-button" tooltip="Puts back what was set when this window opened, or was last applied." />
            <ui:Button name="settings-apply" text="APPLY" class="settings-footer-button kn-button-primary" tooltip="Keeps the changes." />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
