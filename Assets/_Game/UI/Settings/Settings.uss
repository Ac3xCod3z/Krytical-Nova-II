/*
 * Settings window (HudSettingsController): the tab strip and the rows the pages are built from
 * (SettingsRows). Shared looks (panel, buttons, toggles) come from ../Common/KryticalTheme.uss.
 */

#settings-window { left: 50%; top: 64px; width: 460px; translate: -50% 0; display: none; }
#settings-body { max-height: 470px; }

/* ------------------------------------------------------------------ tabs */

.settings-tabs { flex-direction: row; margin-top: 2px; }
.settings-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 28px;
    margin: 4px 2px 0 2px;
    padding: 4px 4px;
    font-size: 11px;
    -unity-background-image-tint-color: rgb(24, 34, 46);
    color: rgb(156, 172, 188);
}
.settings-tab.active { -unity-background-image-tint-color: rgb(30, 112, 98); color: rgb(255, 255, 255); }

.settings-page { display: none; }
.settings-page.active { display: flex; }

/* ------------------------------------------------------------------ rows */

.settings-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
    padding: 6px 10px;
    min-height: 36px;
}
.settings-row-label { flex-grow: 1; flex-shrink: 1; font-size: 13px; color: rgb(208, 220, 230); white-space: normal; }
.settings-row-value { width: 132px; -unity-text-align: middle-center; font-size: 12px; color: rgb(236, 206, 140); }

/* A choice: back, the current value, forward. */
.settings-step { min-width: 26px; min-height: 24px; margin: 0; padding: 0 4px; font-size: 12px; }

/* A slider with its value on the right. */
.settings-slider { width: 150px; margin: 0 8px 0 0; }
.settings-slider-value { width: 46px; -unity-text-align: middle-right; font-size: 12px; color: rgb(236, 206, 140); }
.settings-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgb(40, 56, 72);
}
.settings-slider .unity-base-slider__dragger {
    width: 12px;
    height: 16px;
    margin-top: -8px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgb(114, 222, 196);
}
.settings-slider .unity-base-slider__dragger-border { display: none; }
.settings-row.unavailable .settings-row-label { color: rgb(104, 118, 132); }

/* ------------------------------------------------------------------ controls page */

/* A key is a cap, first on its row; what it does is said after it. */
.settings-key { min-height: 26px; margin: 0 4px 0 0; padding: 2px 8px; font-size: 12px; color: rgb(236, 206, 140); }
.controls-row .key-caps { flex-direction: row; justify-content: flex-end; align-items: center; flex-shrink: 0; width: 150px; min-width: 150px; margin: 0 16px 0 0; padding: 0; }
.controls-row .settings-key { background-image: none; background-color: rgba(0, 0, 0, 0); min-height: 30px; }
.controls-row .settings-row-label { font-size: 14px; }
.key-cap {
    flex-shrink: 0;
    min-width: 30px;
    height: 30px;
    margin: 0 0 0 5px;
    padding: 0 8px;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_03.png#SPR_HUD_SciFiSoldier_Box_03");
    -unity-background-image-tint-color: rgb(16, 58, 96);
    -unity-slice-scale: 0.18px;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.1s;
}
.key-cap.wide { padding: 0 12px; }
.key-cap-text { margin: 0; padding: 0; font-size: 14px; color: rgb(240, 246, 250); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf"); }
.key-cap-picture { width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(240, 246, 250); }
.key-cap-picture.glyph-enter { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Enter_Clean.png"); }
.key-cap-picture.glyph-space { width: 34px; background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Space_Clean.png"); }
.key-cap-picture.glyph-tab { width: 26px; background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Tab_Clean.png"); }
.key-cap-picture.glyph-backspace { width: 26px; background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Backspace_Clean.png"); }
.key-cap-picture.glyph-up { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Arrow_Up_Clean.png"); }
.key-cap-picture.glyph-down { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Arrow_Down_Clean.png"); }
.key-cap-picture.glyph-left { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Arrow_Left_Clean.png"); }
.key-cap-picture.glyph-right { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_Arrow_Right_Clean.png"); }
/* The mouse, with the button that is meant coloured. */
.key-mouse { flex-shrink: 0; width: 24px; height: 32px; margin: 0 0 0 5px; -unity-background-scale-mode: scale-to-fit; }
.key-mouse.mouse-left { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_MouseColor_Left_Underlay.png"); }
.key-mouse.mouse-right { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_MouseColor_Right_Underlay.png"); }
.key-mouse.mouse-middle { background-image: url("/Assets/Synty/InterfaceCore/Sprites/Icons_Input/MouseKeyboard/ICON_Input_PC_MouseColor_Middle_Underlay.png"); }
/* Under the pointer a cap is filled with the accent; while it waits for a key it is brighter still. */
.settings-key:hover .key-cap { -unity-background-image-tint-color: rgb(34, 128, 112); scale: 1.06 1.06; }
.settings-key.listening .key-cap { -unity-background-image-tint-color: rgb(60, 190, 166); }
.controls-row.fixed .key-cap { -unity-background-image-tint-color: rgb(30, 42, 56); }
.controls-row.fixed .key-cap-text { color: rgb(170, 184, 198); }
.settings-key-reset { min-width: 50px; min-height: 26px; margin: 0; padding: 0 6px; font-size: 10px; color: rgb(156, 172, 188); }
.settings-row.fixed .settings-row-label, .settings-row.fixed .settings-row-value { color: rgb(124, 138, 152); }

/* Apply, Revert and Reset to Defaults, under the pages. */
.settings-footer { flex-direction: row; align-items: center; margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(120, 140, 160, 0.35); flex-shrink: 0; }
.settings-footer-gap { flex-grow: 1; }
.settings-footer-button { min-height: 28px; margin: 0 0 0 6px; padding: 2px 12px; font-size: 11px; }
.settings-footer-button:disabled { opacity: 0.45; }
#settings-reset { margin-left: 0; }

/* The menus dim the screen behind the window (MenuSettings). */
#menu-settings { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.menu-settings-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(20, 18, 43, 0.62); display: none; }
