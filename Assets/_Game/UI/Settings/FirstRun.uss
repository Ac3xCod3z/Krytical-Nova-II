/* The first-time setup (FirstRunSetup.uxml): layout only. The card, header, text and buttons wear the theme's and the
   faction skins' classes (.panel, .window, .heading, .kn-button-primary), so each faction's skin dresses it. */

#first-run {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 3, 6, 0.95);
}

.first-run-card {
    width: 640px;
    max-width: 92%;
    padding: 14px 22px 18px 22px;
}

/* A warning has to be read: the card is nearly solid, in each faction's own window colour, whatever the window
   see-through setting is (the other windows keep it). */
#first-run-card { background-color: rgba(9, 15, 23, 0.95); }
.kn-faction-hegemony #first-run-card { background-color: rgba(13, 15, 22, 0.95); }
.kn-faction-null #first-run-card { background-color: rgba(20, 13, 22, 0.95); }
.kn-faction-covenant #first-run-card { background-color: rgba(22, 18, 13, 0.95); }

.first-run-body {
    white-space: normal;
    font-size: 14px;
    color: rgb(222, 230, 238);
    margin: 12px 0 8px 0;
    -unity-text-align: upper-left;
}

.first-run-content {
    align-items: center;
    margin: 6px 0;
}

.first-run-buttons {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 12px;
}

.first-run-buttons > Button, .first-run-choices > Button {
    min-width: 118px;
    height: 34px;
    margin: 4px 4px;
    font-size: 13px;
}

.first-run-choices {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.first-run-chosen {
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(255, 209, 82); border-right-color: rgb(255, 209, 82);
    border-top-color: rgb(255, 209, 82); border-bottom-color: rgb(255, 209, 82);
}

.first-run-swatches {
    flex-direction: row;
    justify-content: center;
    margin: 6px 0;
}

.first-run-swatch {
    width: 52px;
    height: 52px;
    margin: 0 6px;
}

.first-run-value {
    font-size: 16px;
    color: rgb(255, 209, 82);
    -unity-text-align: middle-center;
    margin: 4px 0;
}
