/*
 * Progression HUD layout + component looks. Shared skin (fonts, panels, buttons, bars, scrollbars)
 * lives in ../Shared/KryticalTheme.uss. Positions below are the defaults; players can override
 * them per element from Settings > Customize HUD Layout (HudLayoutEditor writes inline styles).
 */

#game-ui { flex-grow: 1; }

.row { flex-direction: row; align-items: center; justify-content: space-between; }
.heading { font-size: 17px; color: rgb(244, 238, 223); }
.accent { font-size: 13px; }
.muted { font-size: 12px; margin-top: 5px; }
.help { white-space: normal; color: rgb(156, 172, 188); font-size: 12px; margin-top: 8px; }
.section { margin-top: 12px; }

/* ------------------------------------------------------------------ player status frame */

#summary { position: absolute; top: 16px; left: 16px; width: 330px; padding: 14px 18px 12px 18px; }
.summary-top { justify-content: flex-start; margin-bottom: 8px; }
.summary-titles { flex-grow: 1; margin-left: 10px; }
.summary-titles .eyebrow { font-size: 10px; }
.level-badge {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Map_Ring_01_Clean.png#SPR_HUD_SciFiSoldier_Map_Ring_01_Clean");
    -unity-background-image-tint-color: rgb(214, 178, 104);
}
.mode-chip {
    font-size: 11px;
    padding: 3px 8px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_04.png#SPR_HUD_SciFiSoldier_Box_04");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.14);
    -unity-slice-scale: 0.12px;
}

.resource-bar { height: 22px; margin: 3px 0; }
#xp-bar { height: 16px; margin: 5px 0 2px 0; }
#hp-bar .unity-progress-bar__progress { -unity-background-image-tint-color: rgb(196, 58, 74); }
#chi-bar .unity-progress-bar__progress { -unity-background-image-tint-color: rgb(46, 132, 210); }
#xp-bar .unity-progress-bar__progress { -unity-background-image-tint-color: rgb(214, 178, 104); }
#xp-bar .unity-progress-bar__title { font-size: 10px; }

/* ------------------------------------------------------------------ top-right menu */

#menu { position: absolute; right: 16px; top: 16px; }
#menu Button { margin-left: 8px; min-height: 34px; padding: 6px 16px; font-size: 12px; }

/* ------------------------------------------------------------------ windows */

.window { position: absolute; width: 330px; }
#character-window { left: 16px; top: 236px; }
#skills-window { right: 222px; top: 72px; } /* sits left of the minimap */
#character-body { max-height: 340px; }
#skills-body { max-height: 480px; }
.window .kn-header .heading { flex-shrink: 1; }

/* A "+" and the ▾ beside it that picks how many points one press spends (StepDropdown). */
.step-split { flex-direction: row; align-items: stretch; }
.step-split > .step-plus { flex-grow: 1; }
.step-split > .step-caret { min-width: 20px; width: 20px; margin: 0 0 0 2px; padding: 0; font-size: 11px; -unity-text-align: middle-center; -unity-background-image-tint-color: rgb(28, 40, 54); }
.step-popup { flex-direction: column; padding: 4px; width: 84px; }
.step-popup-option { min-height: 24px; margin: 1px 0; padding: 0 8px; font-size: 12px; -unity-text-align: middle-center; -unity-background-image-tint-color: rgb(28, 40, 54); }
.step-popup-option.active-step { -unity-background-image-tint-color: rgb(30, 112, 98); color: rgb(255, 255, 255); }

.stat-row { flex-direction: row; align-items: center; margin-top: 8px; padding: 4px 6px 4px 12px; }
.stat-row > Label { flex-grow: 1; }
.stat-row .stat-value { flex-grow: 0; width: 64px; -unity-text-align: middle-center; color: rgb(236, 206, 140); }
.stat-row Button { min-width: 42px; min-height: 26px; margin: 0; padding: 0 6px; font-size: 12px; }

.combat-stats-container { margin-top: 6px; padding: 8px 12px; }
/* A number of the character is a strip a line, as on the packs' item cards. */
.combat-stat-row { flex-direction: row; justify-content: space-between; align-items: center; margin: 2px 0; padding: 2px 8px; background-color: rgba(0, 0, 0, 0.3); }
.combat-stat-label { font-size: 12px; color: rgb(172, 188, 202); }
.combat-stat-value { font-size: 12px; -unity-font-style: bold; color: rgb(114, 222, 196); }
/* A Serum's entry on the Character Sheet: name and count on one line, the total it adds on the next. */
.serum-row { flex-wrap: wrap; }
.serum-gain { width: 100%; white-space: normal; -unity-text-align: middle-left; }
.vital-breakdown { font-size: 10px; margin-top: 0; margin-bottom: 4px; }


/* ------------------------------------------------------------------ the skill tree (SkillTreeView)
   The Skills window is wide: tiles on tiers by level with lines along each line of skills, and beside them the card
   of the tile that is chosen (the cards are the list this window always had; all but the chosen one are hidden). */
#skills-window.skill-tree { width: 920px; }
.skill-tree-layout { flex-direction: row; }
.skill-tree-side { flex-grow: 1; flex-shrink: 1; }
.skill-tree-title { font-size: 12px; letter-spacing: 1px; margin: 2px 0 6px 2px; }
/* The Arsenal's tabs (STRIKES, WARDS, STRIDES), bare words with a line of the accent under the one on show, as the chat's are. */
.skill-tabs { flex-direction: row; flex-shrink: 0; margin: 0 0 6px 0; }
.skill-tab {
    flex-grow: 1;
    min-height: 24px;
    margin: 0 2px;
    padding: 3px 4px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(170, 186, 200);
}
.skill-tab--active {
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(34, 128, 112);
    border-bottom-width: 2px;
    border-bottom-color: rgb(114, 222, 196);
}
/* The headed groups across the top of the board (AREA, SINGLE HIT, TWO-HIT, THREE-HIT; STANCE, GUARD, SHARED; RUN, JUMP). */
.skill-tree-group {
    position: absolute;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(214, 178, 104);
    border-bottom-width: 1px;
    border-bottom-color: rgba(214, 178, 104, 0.5);
    margin: 0 2px;
}
.skill-tree-scroll { max-height: 524px; }
.skill-tree-canvas { flex-shrink: 0; }
#skills-window.skill-tree #skills-body { width: 300px; max-height: 556px; flex-shrink: 0; margin-left: 12px; }
#skills-window.skill-tree #skills-body .category-header, #skills-window.skill-tree #skills-body .kn-section-bar { display: none; }
#skills-window.skill-tree #skills-body .skill-card { margin-top: 8px; }
.skill-tree-row { position: absolute; left: 0; right: 0; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.07); }
.skill-tree-row.alternate { background-color: rgba(255, 255, 255, 0.035); }
.skill-tree-tier { position: absolute; left: 4px; top: 22px; font-size: 10px; letter-spacing: 1px; color: rgb(150, 166, 180); }
.skill-tree-lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.skill-node { position: absolute; align-items: center; padding-top: 6px; }
.skill-node-tile {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_03.png#SPR_HUD_SciFiSoldier_Box_03");
    -unity-background-image-tint-color: rgb(28, 76, 70);
    -unity-slice-scale: 0.14px;
    transition-property: scale;
    transition-duration: 0.1s;
}
.skill-node-tile:hover { scale: 1.08 1.08; }
.skill-node-icon { position: absolute; left: 4px; top: 4px; right: 4px; bottom: 4px; -unity-background-scale-mode: scale-to-fit; }
.skill-node-rank {
    position: absolute;
    right: -6px;
    bottom: -5px;
    padding: 0 3px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(232, 242, 250);
    background-color: rgba(8, 12, 18, 0.86);
}
.skill-node-name { width: 62px; margin-top: 4px; font-size: 9px; -unity-text-align: upper-center; white-space: normal; color: rgb(214, 228, 236); }
.skill-node.unlearned .skill-node-icon { opacity: 0.5; }
.skill-node.unlearned .skill-node-tile { -unity-background-image-tint-color: rgb(30, 40, 52); }
.skill-node.too-low .skill-node-icon { opacity: 0.22; }
.skill-node.too-low .skill-node-name { color: rgb(130, 142, 154); }
.skill-node.locked .skill-node-tile { -unity-background-image-tint-color: rgb(74, 58, 26); }
.skill-node.locked .skill-node-icon { opacity: 0.3; }
.skill-node.locked .skill-node-rank { color: rgb(248, 210, 120); }
.skill-node.can-upgrade .skill-node-rank { color: rgb(140, 238, 212); }
.skill-node.can-upgrade.unlearned .skill-node-tile { -unity-background-image-tint-color: rgb(24, 62, 58); }
.skill-node.selected .skill-node-tile { scale: 1.14 1.14; -unity-background-image-tint-color: rgb(52, 138, 124); }
.skill-node.selected .skill-node-name { color: rgb(255, 255, 255); -unity-font-style: bold; }

/* ------------------------------------------------------------------ skill cards */

.skill-card { padding: 12px; margin-top: 10px; }
.skill-token {
    padding: 9px 12px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_03.png#SPR_HUD_SciFiSoldier_Box_03");
    -unity-background-image-tint-color: rgb(28, 76, 70);
    -unity-slice-scale: 0.14px;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.12s;
}
.skill-token:hover { -unity-background-image-tint-color: rgb(38, 104, 94); scale: 1.02 1.02; }
.skill-icon { font-size: 17px; color: rgb(140, 238, 212); letter-spacing: 1px; }
.skill-rank { font-size: 11px; margin-top: 3px; color: rgb(214, 228, 236); }
/* The skill's icon on its drag tile; the text makes room for it. */
.skill-art {
    position: absolute;
    left: 8px; top: 50%;
    width: 44px; height: 44px;
    translate: 0 -50%;
    -unity-background-scale-mode: scale-to-fit;
}
.skill-token.has-art { padding-left: 60px; min-height: 56px; justify-content: center; }

.jump-token { -unity-background-image-tint-color: rgb(36, 54, 102); }
.jump-token:hover { -unity-background-image-tint-color: rgb(48, 72, 136); }
.jump-token .skill-icon { color: rgb(150, 190, 255); }
.rage-token { -unity-background-image-tint-color: rgb(92, 30, 38); }
.rage-token:hover { -unity-background-image-tint-color: rgb(122, 40, 50); }
.rage-token .skill-icon { color: rgb(255, 146, 156); }
.serenity-token { -unity-background-image-tint-color: rgb(22, 64, 84); }
.serenity-token:hover { -unity-background-image-tint-color: rgb(30, 88, 112); }
.serenity-token .skill-icon { color: rgb(136, 224, 255); }
.rare-token { -unity-background-image-tint-color: rgb(74, 58, 26); }
.rare-token:hover { -unity-background-image-tint-color: rgb(100, 78, 34); }
.rare-token .skill-icon { color: rgb(248, 210, 120); }

#run-values, #jump-values, #resource-values { white-space: normal; font-size: 12px; }
.category-header { padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgba(214, 178, 104, 0.3); margin-top: 16px; }
.rare-header { color: rgb(240, 186, 84); }
.drop-book-note { color: rgb(226, 178, 84); font-size: 11px; -unity-font-style: italic; white-space: normal; margin-top: 3px; }
.rare-skill-card { -unity-background-image-tint-color: rgba(42, 36, 24, 0.95); }
.future-skill { opacity: 0.65; }

/* ------------------------------------------------------------------ settings + network */

.kn-toggle { margin-top: 6px; }
.keys-help { -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf"); color: rgb(196, 210, 222); }

/* Bottom right: the bottom-left corner belongs to the chat window. */
#network-panel { position: absolute; right: 16px; bottom: 96px; width: 290px; padding: 12px 16px; }
.network-status { margin-top: 4px; white-space: normal; font-size: 12px; }
.network-fields { justify-content: flex-start; }
.network-ip { flex-grow: 1; margin-right: 6px; }
.network-port { width: 104px; }
.network-code { flex-grow: 1; margin-right: 6px; }
.network-buttons Button { flex-grow: 1; margin: 4px 2px; padding: 5px 6px; }


/* ------------------------------------------------------------------ bottom HUD */

#hotbar-dock { position: absolute; bottom: 10px; left: 50%; translate: -50% 0; align-items: center; }
#hotbar { flex-direction: row; padding: 9px 12px; -unity-background-image-tint-color: rgba(7, 12, 19, 0.9); }

.hotbar-slot {
    width: 58px;
    height: 70px;
    margin: 0 3px;
    padding: 5px 4px 4px 4px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_Glass_04.png#SPR_HUD_SciFiSoldier_Box_Glass_04");
    -unity-background-image-tint-color: rgba(64, 86, 106, 0.85);
    -unity-slice-scale: 0.14px;
    transition-property: -unity-background-image-tint-color, scale, opacity;
    transition-duration: 0.1s;
}
.hotbar-slot > .kn-frame {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Frame_04.png#SPR_HUD_SciFiSoldier_Frame_04");
    -unity-background-image-tint-color: rgba(150, 176, 196, 0.45);
    -unity-slice-scale: 0.12px;
}
.hotbar-slot:hover { -unity-background-image-tint-color: rgba(90, 124, 148, 0.95); scale: 1.04 1.04; }
.hotbar-slot:hover > .kn-frame { -unity-background-image-tint-color: rgba(200, 222, 236, 0.8); }
.hotbar-slot.selected { -unity-background-image-tint-color: rgba(40, 150, 124, 0.95); }
.hotbar-slot.selected > .kn-frame { -unity-background-image-tint-color: rgb(140, 255, 220); }
.hotbar-slot.drop-target { -unity-background-image-tint-color: rgba(150, 120, 50, 0.95); }
.hotbar-slot.drop-target > .kn-frame { -unity-background-image-tint-color: rgb(255, 214, 92); }
.hotbar-slot.on-cooldown { opacity: 0.6; }
/* The Autobuff in the Autopilot window: its tile and two rows of four cells, Hotbar slots in all but name. */
.autobuff-row { flex-direction: row; align-items: center; margin: 6px 0 10px 0; }
.autobuff-tile { margin-right: 18px; }
.autobuff-grid { flex-direction: column; }
.autobuff-cells { flex-direction: row; margin-bottom: 6px; }
.autobuff-cell { width: 54px; height: 62px; }
.autobuff-cell.drop-target, .hotbar-slot.autobuff-cell.drop-target { -unity-background-image-tint-color: rgba(40, 150, 124, 0.95); scale: 1.06 1.06; }
/* Comic skill / item icon, under the key and rank labels. A slot with an icon leaves its name to the tooltip. */
.slot-icon {
    position: absolute;
    left: 4px; top: 10px;
    width: 50px; height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}
/* An Autoward cell is smaller than a Hotbar slot and has no key label: its ward sits in the middle (54×62 cell). */
.autobuff-cell .slot-icon { left: 4px; top: 8px; width: 46px; height: 46px; }
.hotbar-slot.has-icon .slot-name { visibility: hidden; }
.hotbar-slot.has-icon .slot-key, .hotbar-slot.has-icon .slot-rank { text-shadow: 1px 1px 0 rgb(20, 18, 43); }
/* Ink sweep over the icon: full height at the start of a cooldown, draining to nothing (height set in code). */
.slot-cooldown {
    position: absolute;
    left: 4px; right: 4px; bottom: 4px;
    height: 0;
    max-height: 62px;
    background-color: rgba(20, 18, 43, 0.72);
}
.hotbar-slot.insufficient-chi > .kn-frame { -unity-background-image-tint-color: rgb(220, 80, 88); }
/* The skill waiting to be cast: the character is walking into reach, or its swing is not over yet. */
.hotbar-slot.queued { -unity-background-image-tint-color: rgba(40, 150, 124, 0.95); }
.hotbar-slot.queued > .kn-frame { -unity-background-image-tint-color: rgb(140, 255, 220); }
.hotbar-slot.charging { -unity-background-image-tint-color: rgba(150, 60, 70, 0.95); scale: 1.06 1.06; }
.hotbar-slot.charging > .kn-frame { -unity-background-image-tint-color: rgb(255, 146, 156); }
.hotbar-slot-letter .slot-key { color: rgb(140, 238, 212); }
.hotbar-divider { width: 1px; margin: 6px 7px; background-color: rgba(114, 222, 196, 0.35); }

/* ---- Faction HUD pieces (HudChrome): the faction's Synty prefab is what is seen; these stay what is clicked.
        They keep their rectangles (the piece sets each slot's place) and lose their look. Never hide the slots or
        the dock themselves: the layout editor, the pet bubbles and click blocking all need to find them. ---- */
.hud-chrome #game-ui #hotbar { padding: 0; background-image: none; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.hud-chrome #game-ui #hotbar > .kn-frame, .hud-chrome #game-ui #hotbar > .kn-pip, .hud-chrome #game-ui .hotbar-divider { display: none; }
.hud-chrome #game-ui .hotbar-slot { margin: 0; padding: 0; background-image: none; background-color: rgba(0, 0, 0, 0); opacity: 1; scale: 1 1; }
.hud-chrome #game-ui .hotbar-slot:hover, .hud-chrome #game-ui .hotbar-slot.charging { scale: 1 1; }
.hud-chrome #game-ui .hotbar-slot > * { visibility: hidden; }
.hud-chrome #game-ui #summary { padding: 0; background-image: none; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.hud-chrome #game-ui #summary > .kn-frame, .hud-chrome #game-ui #summary > .kn-pip { display: none; }
.hud-chrome #game-ui #summary > * { visibility: hidden; position: absolute; }
/* The minimap keeps its map, markers, north mark and buttons; the dial round them is the faction's, and reaches out past the element. */
.hud-chrome .minimap { right: 40px; top: 92px; }
.hud-chrome .minimap > .minimap-frame, .hud-chrome .minimap > .minimap-ring { display: none; }
.hud-chrome .minimap > .minimap-mask, .hud-chrome .minimap > .minimap-backdrop { left: 0; top: 0; right: 0; bottom: 0; }
/* The faction's Hotbar reaches a little further left than the old strip did at this size: the chat stops short of it. */
.hud-chrome .chat-window { width: 390px; }
.blade-token { -unity-background-image-tint-color: rgb(58, 40, 92); }
.blade-token:hover { -unity-background-image-tint-color: rgb(78, 54, 124); }
.blade-token .skill-icon { color: rgb(206, 170, 255); }

.hotbar-slot Label { margin: 0; padding: 0; min-height: 0; }
.slot-key { height: 14px; flex-shrink: 0; font-size: 11px; color: rgb(236, 206, 140); -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf"); }
.slot-name { height: 26px; flex-shrink: 0; -unity-text-align: middle-center; font-size: 10px; white-space: normal; color: rgb(236, 244, 248); }
.slot-rank { height: 14px; flex-shrink: 0; -unity-text-align: middle-center; font-size: 9px; color: rgb(156, 180, 198); }

.controls {
    font-size: 11px;
    color: rgb(200, 214, 226);
    margin-top: 6px;
    padding: 3px 12px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01.png#SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01");
    -unity-background-image-tint-color: rgba(6, 12, 18, 0.85);
    -unity-slice-scale: 0.1px;
}

.feedback {
    position: absolute;
    bottom: 132px;
    left: 50%;
    translate: -50% 0;
    max-width: 640px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 6px 28px;
    color: rgb(240, 222, 176);
    font-size: 12px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01.png#SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01");
    -unity-background-image-tint-color: rgba(6, 12, 18, 0.9);
    -unity-slice-scale: 0.14px;
}

.active-buffs-bar { position: absolute; bottom: 166px; left: 50%; translate: -50% 0; flex-direction: row; justify-content: center; align-items: center; }

/* Item boosts that are running (XP Boosters; later, time in a premium zone): text down the right edge, one line each
   with a clock. Nothing is there while nothing runs. Placed like any panel. */
.boost-list { position: absolute; right: 14px; top: 30%; min-width: 150px; flex-direction: column; align-items: flex-end; }
.boost-line {
    margin: 0 0 2px 0; padding: 1px 6px 2px 6px; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-right; white-space: nowrap;
    color: rgb(255, 226, 132); text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
    background-color: rgba(8, 12, 18, 0.45); border-radius: 3px;
}
.boost-line.ending { color: rgb(255, 150, 110); }

/* The moments of play, top centre: news for the whole server, then the player's own milestones (a level of
   Ascension, a Nova, a Standing rank, a pet's evolution). One column, so two at once stack instead of covering each
   other. It has a width of its own so its middle stays put whatever is in it; placed like any panel. */
.milestone-banner {
    position: absolute;
    top: 2%;
    left: 50%;
    translate: -50% 0;
    width: 760px;
    align-items: center;
}
/* What stands in the column gives up its own place on the screen. */
.milestone-banner > .toast { position: relative; top: auto; left: auto; translate: 0 -12px; }
.milestone-banner > .toast--shown { translate: 0 0; }
.milestone-banner > .nova-banner,
.milestone-banner > .pet-evolved { position: relative; top: auto; left: auto; translate: 0 0; margin-top: 6px; }
.buff-badge {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px;
    margin: 0 3px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_04.png#SPR_HUD_SciFiSoldier_Box_04");
    -unity-background-image-tint-color: rgba(16, 40, 50, 0.92);
    -unity-slice-scale: 0.12px;
}
.buff-badge.shield-badge { -unity-background-image-tint-color: rgba(70, 56, 18, 0.95); }
.buff-badge.channeled-badge { -unity-background-image-tint-color: rgba(14, 56, 72, 0.95); }
.buff-badge-name { font-size: 11px; -unity-font-style: bold; color: rgb(232, 242, 250); margin-right: 5px; }
.buff-badge-icon { width: 26px; height: 26px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; }
.buff-badge-timer { font-size: 11px; color: rgb(114, 222, 196); }

#drag-ghost {
    display: none;
    position: absolute;
    width: 90px;
    height: 48px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/exo-2-0/Exo2.0-SemiBold.otf");
    white-space: normal;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Box_03.png#SPR_HUD_SciFiSoldier_Box_03");
    -unity-background-image-tint-color: rgba(30, 128, 108, 0.95);
    -unity-slice-scale: 0.14px;
}
/* A skill with an icon drags as the icon itself (set inline) instead of the text chip. */
#drag-ghost.icon-ghost {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
}

/* ------------------------------------------------------------------ HUD edit banner */

#hud-edit-banner {
    display: none;
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px;
    -unity-background-image-tint-color: rgba(9, 15, 23, 0.96);
}
.hud-edit-banner-text { margin-right: 14px; }
.hud-edit-banner-text .help { margin-top: 2px; }
#hud-edit-banner Button { margin-left: 8px; }
.hud-edit-pick { min-width: 190px; -unity-background-image-tint-color: rgb(96, 78, 30); color: rgb(255, 236, 180); }
.hud-edit-pick:hover { -unity-background-image-tint-color: rgb(128, 104, 40); }

/* The list the PANEL button opens, under the banner. */
.hud-edit-list {
    display: none;
    position: absolute;
    top: 92px;
    left: 50%;
    translate: -50% 0;
    width: 280px;
    max-height: 430px;
    padding: 8px 10px;
    -unity-background-image-tint-color: rgba(9, 15, 23, 0.97);
}
.hud-edit-list Button { margin: 2px 0; min-height: 26px; padding: 2px 10px; font-size: 12px; -unity-text-align: middle-left; }
.hud-edit-list Button.chosen { -unity-background-image-tint-color: rgb(30, 112, 98); color: rgb(255, 255, 255); }

/* ------------------------------------------------------------------ floating combat text (CombatFeedbackManager) */

.floating-combat-text {
    position: absolute;
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
    font-size: 18px;
    color: rgb(255, 112, 100);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(16, 6, 6);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
    padding: 2px 6px;
}
.floating-combat-text.crit { font-size: 24px; color: rgb(255, 222, 84); -unity-text-outline-color: rgb(48, 26, 0); }
.floating-combat-text.evade { font-size: 15px; color: rgb(140, 220, 250); -unity-text-outline-color: rgb(4, 18, 30); }
.floating-combat-text.reflected { font-size: 16px; color: rgb(196, 156, 255); -unity-text-outline-color: rgb(18, 8, 34); }

/* A full-screen, click-through layer for a template instanced into the HUD (banners, prompts, windows). */
.hud-overlay-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Character Sheet: Renown, Ascension and the Standing worn, at the top. Hover for the breakdown. */
.renown-block { padding: 8px 10px; }
.renown-row { flex-direction: row; align-items: center; min-height: 20px; }
.renown-label { flex-grow: 1; font-size: 12px; color: rgb(156, 172, 188); }
.renown-value { font-size: 13px; -unity-font-style: bold; color: rgb(255, 222, 130); }
.renown-value-plain { font-size: 12px; color: rgb(226, 234, 242); }

/* Namecards over players' heads (PlayerNamecardController). The name's colour is the faction's, set in code. */
.player-namecards { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.namecard {
    position: absolute;
    align-items: center;
    padding: 3px 16px 4px 16px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01.png#SPR_HUD_SciFiSoldier_Gradient_Outwards_Smooth_01");
    -unity-background-image-tint-color: rgba(6, 12, 18, 0.66);
    -unity-slice-scale: 0.1px;
}
.namecard-row { flex-direction: row; align-items: center; }
.namecard-crest { width: 18px; height: 18px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; }
.namecard-name {
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}
.namecard-standing {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 222, 130);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}
.namecard-crew {
    font-size: 12px;
    color: rgb(206, 218, 230);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

/* A pet's speech bubble (PetBubbleController, ComicBubble). The bubble is drawn in code from the --bubble values
   below: Colour Bible ink and paper, shadow indigo dots. It sits in the world layer, under every window. */
.pet-bubbles { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.comic-bubble {
    position: absolute;
    --bubble-ink: rgb(20, 18, 43);
    --bubble-paper: rgb(244, 238, 223);
    --bubble-dot: rgba(76, 82, 191, 0.6);
    --bubble-shadow: rgba(20, 18, 43, 0.55);
    --bubble-line: 3;
    --bubble-radius: 14;
    --bubble-tail: 14;
    --bubble-shadow-offset: 4;
    --bubble-dot-cell: 7;
    --bubble-dot-reach: 0.4;
    /* room for the outline, the tail (on the right unless the bubble has flipped) and the shadow */
    padding: 9px 31px 13px 13px;
    opacity: 0;
    scale: 0.6 0.6;
    transform-origin: right center;
    transition-property: opacity, scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-back;
}
.comic-bubble--tail-left { padding: 9px 17px 13px 27px; transform-origin: left center; }
.comic-bubble--shown { opacity: 1; scale: 1 1; }
.pet-bubble-text {
    color: rgb(20, 18, 43);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}
.pet-bubble-emoji {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}
