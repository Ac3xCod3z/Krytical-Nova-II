/* World map window. Chrome from Synty SciFi Menus (Background_SciFiMenus_01); markers from the SciFi Soldier HUD map set.
   Builds on KryticalTheme.uss / ProgressionHUD.uss (.panel, .window, .kn-*). */

.world-map-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-map .header-key { font-size: 11px; margin-left: 6px; -unity-text-align: middle-left; }
.world-map .header-spacer { flex-grow: 1; }

/* Large by default, never full screen; players move and scale it through the HUD layout editor. */
#world-map {
    left: 50%;
    top: 44px;
    width: 548px;
    translate: -50% 0;
    display: none;
}

/* ------------------------------------------------------------------ chrome */

.world-map-backdrop, .world-map-hexagons {
    position: absolute;
    left: 6px; top: 6px; right: 6px; bottom: 6px;
    -unity-background-scale-mode: scale-and-crop;
}
.world-map-backdrop {
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Background_01.png");
    -unity-background-image-tint-color: rgba(60, 110, 120, 0.35);
}
.world-map-hexagons {
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Background_Hexagons_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.07);
}
.world-map-corner {
    position: absolute;
    width: 26px;
    height: 26px;
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Menu_Triangle_Small_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.8);
    -unity-background-scale-mode: scale-to-fit;
}
.world-map-corner-tl { left: -4px; top: -4px; }
.world-map-corner-br { right: -4px; bottom: -4px; rotate: 180deg; }

.world-map-title { -unity-font-definition: url("/Assets/Synty/InterfaceSciFiMenus/Fonts/Zen_Dots/ZenDots-Regular.ttf"); letter-spacing: 2px; }
.world-map-zone { margin-left: 12px; font-size: 12px; -unity-text-align: middle-left; }
.world-map-center { min-height: 24px; height: 24px; margin: 0 8px 0 0; padding: 0 10px; font-size: 11px; }

/* ------------------------------------------------------------------ map */

.world-map-viewport {
    width: 500px;
    height: 500px;
    margin: 8px auto 6px auto;
    overflow: hidden;
    background-color: rgba(6, 12, 18, 0.96);
    border-width: 1px;
    border-color: rgba(114, 222, 196, 0.45);
}

/* Sized and translated in code (zoom / pan). Tinted toward the HUD teal so the baked capture reads as a hologram. */
.world-map-content {
    position: absolute;
    left: 0;
    top: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(150, 214, 212);
}
.world-map-grid {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Background_Crosses_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.16);
    -unity-background-scale-mode: scale-and-crop;
}
.world-map-scanlines, .world-map-vignette {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
.world-map-scanlines {
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Background_ScanLines_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.10);
}
.world-map-vignette {
    background-image: url("/Assets/Synty/InterfaceSciFiMenus/Sprites/General/SPR_SciFiMenus_Background_Vignette_01.png");
    -unity-background-image-tint-color: rgba(4, 8, 12, 0.75);
}
.world-map-north {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 20px;
    height: 20px;
    margin: 0;
    padding: 0;
    translate: -50% 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(236, 206, 140);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
    background-color: rgba(9, 15, 23, 0.9);
    border-radius: 10px;
}

/* ------------------------------------------------------------------ markers (children of the content, map pixels) */

.world-map-marker { position: absolute; -unity-background-scale-mode: scale-to-fit; }
.world-map-marker.npc {
    width: 10px; height: 10px;
    border-radius: 50%;
    background-color: rgb(236, 196, 92);
    border-width: 1.5px;
    border-color: rgb(20, 18, 30);
}
.world-map-marker.ally {
    width: 16px; height: 16px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Player_01_Clean.png");
    -unity-background-image-tint-color: rgb(120, 190, 255);
}
/* A GM's view of a player this game does not have yet (gm.seeall): a gold-rimmed dot with the name. */
.world-map-marker.gm-seen {
    width: 12px; height: 12px;
    border-radius: 50%;
    background-color: rgb(236, 236, 244);
    border-width: 2px;
    border-color: rgb(255, 196, 60);
}
.world-map-marker.portal {
    width: 24px; height: 24px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Objective_01_Clean.png");
    -unity-background-image-tint-color: rgb(186, 120, 255);
}
.world-map-marker.waypoint {
    width: 26px; height: 26px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Flag_01.png");
    -unity-background-image-tint-color: rgb(255, 201, 60);
}
.world-map-marker.poi {
    width: 14px; height: 14px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Star_01.png");
    -unity-background-image-tint-color: rgb(244, 238, 223);
    overflow: visible;
}
.world-map-poi-label {
    position: absolute;
    left: -60px;
    top: 13px;
    width: 134px;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-center;
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(226, 236, 242);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
}

/* Local player: view cone under a teal triangle that points where the character faces. */
.world-map-player { position: absolute; width: 26px; height: 26px; }
.world-map-player-cone {
    position: absolute;
    left: -19px; top: -44px;
    width: 64px; height: 64px;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/HUD/SPR_HUD_SciFiSoldier_Map_PlayerViewCone_01.png");
    -unity-background-image-tint-color: rgba(114, 222, 196, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}
.world-map-player-icon {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Player_01_Clean.png");
    -unity-background-image-tint-color: rgb(114, 222, 196);
    -unity-background-scale-mode: scale-to-fit;
}

/* ------------------------------------------------------------------ footer */

.world-map-footer { align-items: center; }
.world-map-coords {
    font-size: 12px;
    color: rgb(236, 206, 140);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
}
.world-map-legend { font-size: 10px; margin: 0 8px 0 3px; color: rgb(170, 186, 200); }
.world-map-legend-icon { width: 10px; height: 10px; -unity-background-scale-mode: scale-to-fit; }
.legend-you {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Player_01_Clean.png");
    -unity-background-image-tint-color: rgb(114, 222, 196);
}
.legend-ally {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Player_01_Clean.png");
    -unity-background-image-tint-color: rgb(120, 190, 255);
}
.legend-npc { border-radius: 50%; background-color: rgb(236, 196, 92); }
.legend-portal {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Objective_01_Clean.png");
    -unity-background-image-tint-color: rgb(186, 120, 255);
}
.legend-poi {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Star_01.png");
    -unity-background-image-tint-color: rgb(244, 238, 223);
}
.legend-waypoint {
    background-image: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Sprites/Icons_Map/ICON_SciFiSoldier_Map_Flag_01.png");
    -unity-background-image-tint-color: rgb(255, 201, 60);
}
.world-map-help { margin-top: 4px; font-size: 10px; }

/* ------------------------------------------------------------------ the Calendar page (MapCalendarView) */

.world-map-tab { min-height: 24px; height: 24px; margin: 0 0 0 8px; padding: 0 10px; font-size: 11px; opacity: 0.6; }
.world-map-tab.selected { opacity: 1; border-color: rgb(114, 222, 196); color: rgb(114, 222, 196); }
.world-map-calendar { display: none; width: 500px; height: 500px; margin: 8px auto 6px auto; }
.world-map.calendar-open .world-map-calendar { display: flex; }
.world-map.calendar-open .world-map-viewport,
.world-map.calendar-open .world-map-footer,
.world-map.calendar-open .world-map-help,
.world-map.calendar-open .world-map-center { display: none; }

.calendar-scroll { flex-grow: 1; }
.calendar-box {
    margin: 0 0 6px 0;
    padding: 6px 8px;
    background-color: rgba(6, 12, 18, 0.92);
    border-width: 1px;
    border-color: rgba(114, 222, 196, 0.45);
    border-radius: 2px;
}
.calendar-heading {
    font-size: 11px;
    margin: 0 0 4px 0;
    color: rgb(114, 222, 196);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
}
.calendar-date {
    font-size: 16px;
    color: rgb(236, 206, 140);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
    -unity-font-definition: url("/Assets/Synty/InterfaceSciFiSoldierHUD/Fonts/Orbitron/Orbitron-ExtraBold.ttf");
}
.calendar-sub { font-size: 11px; color: rgb(190, 204, 214); white-space: normal; }
.calendar-strong { font-size: 12px; -unity-font-style: bold; color: rgb(236, 206, 140); }
.calendar-season-bar { height: 6px; margin: 4px 0; background-color: rgba(114, 222, 196, 0.15); border-width: 1px; border-color: rgba(114, 222, 196, 0.5); }
.calendar-season-fill { height: 100%; background-color: rgb(114, 222, 196); }

.calendar-row { flex-direction: row; }
.calendar-moon { flex-grow: 1; flex-basis: 0; margin-right: 6px; }
.calendar-tonight { flex-grow: 1; flex-basis: 0; }
.calendar-moon-line { flex-direction: row; align-items: center; }
.calendar-moon-glyph { width: 40px; height: 40px; margin-right: 8px; flex-shrink: 0; }
.calendar-moon-text { flex-shrink: 1; flex-grow: 1; }

.calendar-grid-row { flex-direction: row; align-items: stretch; margin-bottom: 2px; }
.calendar-grid-tag { width: 34px; font-size: 9px; -unity-text-align: middle-center; color: rgb(114, 222, 196); }
.calendar-cell {
    flex-grow: 1; flex-basis: 0; height: 46px; margin: 0 1px; padding: 1px;
    align-items: center;
    background-color: rgba(20, 30, 42, 0.9);
    border-width: 1px; border-color: rgba(114, 222, 196, 0.2);
}
.calendar-cell.today { border-color: rgb(236, 206, 140); border-width: 2px; background-color: rgba(60, 50, 24, 0.9); }
.calendar-cell.past { opacity: 0.45; }
.calendar-cell-time { font-size: 9px; color: rgb(170, 186, 200); margin: 0; padding: 0; }
.calendar-cell-moon { width: 16px; height: 16px; }
.calendar-cell-dots { flex-direction: row; height: 8px; margin-top: 2px; }
.calendar-dot { width: 7px; height: 7px; margin: 0 1px; border-radius: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0.8); }
.calendar-dot-emberfall { background-color: rgb(255, 140, 60); }
.calendar-dot-palewanderer { background-color: rgb(170, 210, 255); }
.calendar-dot-eclipse { background-color: rgb(190, 140, 255); }
.calendar-dot-aurora { background-color: rgb(120, 255, 170); }
.calendar-dot-nebula { background-color: rgb(255, 140, 200); }
.calendar-legend { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 4px; }
.calendar-legend-text { font-size: 10px; margin: 0 8px 0 2px; color: rgb(170, 186, 200); }

.calendar-event { flex-direction: row; justify-content: space-between; padding: 2px 0; border-bottom-width: 1px; border-color: rgba(114, 222, 196, 0.12); }
.calendar-event-name { font-size: 11px; -unity-font-style: bold; color: rgb(236, 206, 140); }
.calendar-event-emberfall { color: rgb(255, 160, 90); }
.calendar-event-palewanderer { color: rgb(170, 210, 255); }
.calendar-event-eclipse { color: rgb(200, 160, 255); }
.calendar-event-aurora { color: rgb(120, 255, 170); }
.calendar-event-time { font-size: 11px; color: rgb(190, 204, 214); }

.calendar-forecast { flex-direction: row; }
.calendar-fc {
    flex-grow: 1; flex-basis: 0; margin: 0 1px; padding: 3px 2px;
    align-items: center;
    background-color: rgba(20, 30, 42, 0.9);
    border-width: 1px; border-color: rgba(114, 222, 196, 0.25);
}
.calendar-fc-when { font-size: 10px; color: rgb(114, 222, 196); -unity-font-style: bold; }
.calendar-fc-look { font-size: 10px; -unity-font-style: bold; color: rgb(236, 206, 140); margin-top: 2px; }
.calendar-fc-spell { font-size: 9px; color: rgb(170, 186, 200); white-space: normal; -unity-text-align: middle-center; }
.calendar-fc-temp { font-size: 12px; -unity-font-style: bold; color: rgb(236, 236, 236); margin: 2px 0; }
.calendar-fc-chance { font-size: 9px; color: rgb(170, 186, 200); }
.calendar-fc.look-rain .calendar-fc-look { color: rgb(120, 180, 255); }
.calendar-fc.look-snow .calendar-fc-look { color: rgb(230, 240, 255); }
.calendar-fc.look-blizzard .calendar-fc-look { color: rgb(200, 220, 255); }
.calendar-fc.look-storm .calendar-fc-look { color: rgb(200, 160, 255); }
.calendar-fc.look-heat .calendar-fc-look { color: rgb(255, 150, 80); }
.calendar-fc.look-heat { border-color: rgba(255, 150, 80, 0.6); }
.calendar-fc.look-blizzard, .calendar-fc.look-snow { border-color: rgba(220, 235, 255, 0.5); }
