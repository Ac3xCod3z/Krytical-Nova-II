<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ToastPanels.uss" />
    <!-- Instanced into ProgressionHUD.uxml; driven by ToastHudController. A thin band across the top of the HUD on
         which news every player on the server is told runs by, one message at a time, several passes each. -->
    <ui:VisualElement name="toast" class="toast panel" picking-mode="Ignore">
        <ui:Label name="toast-eyebrow" text="GM" class="eyebrow toast-eyebrow" picking-mode="Ignore" />
        <ui:Label name="toast-text" text="" class="toast-text" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
