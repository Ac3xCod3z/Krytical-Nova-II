%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69056ccc8b45b2744be7fdb917aa0883, type: 3}
  m_Name: WorldScale
  m_EditorClassIdentifier: KryticalNova.Runtime::KryticalNova.World.WorldScaleSettings
  personHeight: 1.8
  allowance: 1.25
  shortfall: 0.85
  leaveAlone: 0.05
  factorLimits: {x: 0.35, y: 2.5}
  heroicRatio: 1.5
  monumentalRatio: 3
  colossalRatio: 10
  tinyRatio: 0.16666667
  kinds:
  - id: chair
    axis: 0
    real: 0.95
    min: 0.8075
    max: 1.1875
    root: A dining chair is 0.85 to 1.0 m to the top of its back, its seat at 0.45 m.
  - id: stool
    axis: 0
    real: 0.6
    min: 0.4
    max: 0.9
    root: A stool's seat is 0.45 m; a bar stool's 0.75 m.
  - id: armchair
    axis: 0
    real: 1.1
    min: 0.85
    max: 1.5
    root: An armchair or an office chair is 0.9 to 1.2 m.
  - id: throne
    axis: 0
    real: 1.9
    min: 1.5
    max: 2.7
    root: 'A seat of state stands over the person in it: a head higher than they are, and no more than one and a half times a person.'
  - id: bench
    axis: 1
    real: 1.8
    min: 1.2
    max: 3.2
    root: A bench for three is 1.5 to 1.8 m long.
  - id: sofa
    axis: 1
    real: 2.2
    min: 1.6
    max: 3.1
    root: A three-seat sofa is 2.0 to 2.3 m long.
  - id: bed
    axis: 1
    real: 2
    min: 1.9
    max: 2.6
    root: A bed is 1.9 to 2.0 m long; a made bed with its frame 2.2 m.
  - id: bunk
    axis: 1
    real: 2
    min: 1.9
    max: 3.6
    root: A berth is 1.9 to 2.0 m long; a rack of them is as long as it is wide.
  - id: table
    axis: 0
    real: 0.75
    min: 0.65
    max: 0.95
    root: A dining table or a desk is 0.74 to 0.76 m high.
  - id: lowtable
    axis: 0
    real: 0.45
    min: 0.3
    max: 0.6
    root: A coffee table is 0.4 to 0.5 m high.
  - id: counter
    axis: 0
    real: 1
    min: 0.85
    max: 1.3
    root: A kitchen counter is 0.9 m; a bar 1.05 to 1.1 m.
  - id: tallcase
    axis: 0
    real: 2
    min: 1.5
    max: 3
    root: A wardrobe, bookcase or locker is 1.8 to 2.2 m; library shelving goes a storey high.
  - id: lowcase
    axis: 0
    real: 0.85
    min: 0.6
    max: 1.3
    root: A dresser or a sideboard is 0.75 to 0.95 m high.
  - id: chest
    axis: 1
    real: 0.9
    min: 0.5
    max: 1.4
    root: A sea chest is 0.8 to 1.0 m long.
  - id: crate
    axis: 2
    real: 1
    min: 0.5
    max: 1.5
    root: A shipping crate is 0.6 to 1.2 m on a side.
  - id: barrel
    axis: 0
    real: 0.95
    min: 0.6
    max: 1.25
    root: A wine barrel (a barrique) stands 0.95 m.
  - id: candle
    axis: 0
    real: 0.25
    min: 0.08
    max: 0.7
    root: A candle in its stick is 0.15 to 0.4 m.
  - id: tablelamp
    axis: 0
    real: 0.5
    min: 0.2
    max: 1
    root: A lamp or lantern carried in a hand is 0.3 to 0.6 m.
  - id: floorlamp
    axis: 0
    real: 1.6
    min: 0.9
    max: 2.2
    root: 'A standing lamp or candelabra is 1.4 to 1.8 m: about head height.'
  - id: lamppost
    axis: 0
    real: 4
    min: 2.5
    max: 5.5
    root: A street lamp for walkers is 3 to 5 m.
  - id: chandelier
    axis: 2
    real: 1.2
    min: 0.7
    max: 2.4
    root: A hall chandelier is 0.9 to 1.5 m across.
  - id: brazier
    axis: 0
    real: 1
    min: 0.6
    max: 1.6
    root: 'A brazier burns at waist to chest height: 0.8 to 1.2 m.'
  - id: hearth
    axis: 0
    real: 1.6
    min: 1
    max: 2.8
    root: A fireplace's mantel is 1.2 to 1.5 m; a hall's hearth is taller than a person.
  - id: screen
    axis: 2
    real: 1
    min: 0.25
    max: 2
    root: A monitor is 0.5 to 0.7 m across; a wall screen 1.2 to 1.9 m.
  - id: console
    axis: 0
    real: 1.2
    min: 0.7
    max: 1.9
    root: 'A standing console is worked at with the hands: 1.0 to 1.4 m.'
  - id: machine
    axis: 0
    real: 1.9
    min: 1.2
    max: 2.8
    root: A vending machine or a server rack is 1.8 to 2.0 m.
  - id: statue
    axis: 0
    real: 2.4
    min: 1.2
    max: 4.2
    root: A statue is life size (1.8 m) to heroic, twice life size, on its plinth.
  - id: monument
    axis: 0
    real: 5.4
    min: 4
    max: 9
    root: A monument is three persons high or more.
  - id: fountain
    axis: 1
    real: 3
    min: 1.2
    max: 5.5
    root: A courtyard fountain's basin is 2 to 4 m across.
  - id: well
    axis: 1
    real: 1.8
    min: 1.2
    max: 3.6
    root: A well's mouth is 1.2 to 1.8 m across.
  - id: rug
    axis: 1
    real: 2.5
    min: 0.8
    max: 9.5
    root: A rug is 1.5 to 3 m; a hall runner up to 9 m.
  - id: picture
    axis: 2
    real: 0.9
    min: 0.25
    max: 2.6
    root: A painting, a poster or a mounted shield is 0.4 to 1.5 m.
  - id: banner
    axis: 0
    real: 2.2
    min: 1
    max: 4.5
    root: A hall banner hangs 1.5 to 4 m.
  - id: small
    axis: 2
    real: 0.3
    min: 0.04
    max: 0.9
    root: 'What is held in a hand: a cup, a book, a skull.'
  - id: decor
    axis: 2
    real: 1.5
    min: 0.4
    max: 3.6
    root: A piece of standing decor is between a chair and a wardrobe in size.
  - id: shelter
    axis: 0
    real: 4
    min: 2.5
    max: 10
    root: 'A gazebo or an arch is walked under: 3 to 6 m.'
  - id: potplant
    axis: 0
    real: 0.9
    min: 0.3
    max: 2.2
    root: A plant in a pot is knee to chest high.
  - id: planter
    axis: 1
    real: 1.5
    min: 0.5
    max: 5.2
    root: A planter box is 0.6 to 3 m long.
  - id: flowers
    axis: 0
    real: 0.5
    min: 0.15
    max: 1.3
    root: Flowers stand ankle to knee high.
  - id: bush
    axis: 0
    real: 1.2
    min: 0.5
    max: 2.8
    root: A garden shrub is 0.6 to 2 m.
  - id: hedge
    axis: 0
    real: 1.3
    min: 0.8
    max: 2.2
    root: A clipped hedge is waist to shoulder high.
  - id: smalltree
    axis: 0
    real: 5
    min: 3
    max: 8
    root: A garden tree (a maple, a cherry) is 4 to 7 m.
  - id: tree
    axis: 0
    real: 9
    min: 6
    max: 14
    root: A grown tree is 8 to 12 m, with a crown no wider than it is tall.
  - id: greattree
    axis: 0
    real: 16
    min: 12
    max: 25
    root: 'A great tree is 15 to 25 m: the tallest thing on a Lot.'
  - id: rock
    axis: 2
    real: 1.5
    min: 0.4
    max: 4
    root: A garden boulder is 0.5 to 3 m.
