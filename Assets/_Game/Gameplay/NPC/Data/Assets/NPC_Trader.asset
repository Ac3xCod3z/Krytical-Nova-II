  m_Script: {fileID: 11500000, guid: 1a27028f02e4d244eb12188002cec6a8, type: 3}
  m_Name: NPC_Trader
  m_EditorClassIdentifier: KryticalNova.Runtime::KryticalNova.NPC.NpcDefinition
  role: 3
  displayName: Broker
  title: The Exchange
  greeting: Everything has a buyer, darling. Everything. The trick is knowing who will pay, and how much.
  lines:
  - text: Everything has a buyer, darling. Everything. The trick is knowing who will pay, and how much.
    clip: {fileID: 8300000, guid: 46401dc56db8ecb409965b57c7838ce8, type: 3}
  - text: Rare, tempered, untouched. Name your price, and I will find the one who pays it.
    clip: {fileID: 8300000, guid: 6d2ec2f680fe27443aec1aa030668014, type: 3}
  - text: The market never sleeps, darling. Neither do I.
    clip: {fileID: 8300000, guid: 9dd6bce6f57056346941bba1fd1672d9, type: 3}
  - text: Buy low, sell high, and never tell anyone what you paid.
    clip: {fileID: 8300000, guid: 61515de416f2b22439c60792a33658f1, type: 3}
  - text: Looking or selling? Either way, I take my cut.
    clip: {fileID: 8300000, guid: 0a25872736ea97d4083a526e7bce039c, type: 3}
  services: With a Commission Receipt, list Rare gear (12% Temper or more) on the Exchange, or browse and buy gear listed by other players.
  offers: 0
  interactRange: 3
