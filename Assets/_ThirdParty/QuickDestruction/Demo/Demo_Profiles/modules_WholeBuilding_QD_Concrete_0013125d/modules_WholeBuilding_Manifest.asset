  - AssetPath: Assets/QuickDestruction/Generated/modules_WholeBuilding_QD_Profile_UniformConcrete_0013125d/modules_WholeBuilding_Manifest.asset
    Kind: manifest
  - AssetPath: Assets/QuickDestruction/Generated/modules_WholeBuilding_QD_Profile_UniformConcrete_0013125d/modules_WholeBuilding_Destructible_Interior.mat
    Kind: material
  - AssetPath: Assets/QuickDestruction/Generated/modules_WholeBuilding_QD_Profile_UniformConcrete_0013125d/modules_WholeBuilding_Destructible.prefab
    Kind: prefab
  FragmentCount: 242
