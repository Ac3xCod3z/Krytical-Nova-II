  - AssetPath: Assets/QuickDestruction/Generated/modules_WholeBuilding_modules_LocalProfile_2_0013125d/modules_WholeBuilding_Interior.mat
    Kind: material
  - AssetPath: Assets/QuickDestruction/Generated/modules_WholeBuilding_modules_LocalProfile_2_0013125d/modules_WholeBuilding_Destructible.prefab
    Kind: prefab
